# ── Secrets and environment variables ────────────────────────────────────────
# Contains ANTHROPIC_API_KEY. Committing this would expose the API key.
.env
.env.local
.env.*.local

# ── Python bytecode (generated at import time) ────────────────────────────────
# Python compiles .py files to .pyc automatically. Regenerated on every run.
# Committing these causes merge conflicts with no benefit.
__pycache__/
*.py[cod]

# ── Python virtual environment ────────────────────────────────────────────────
# Reinstallable from scratch with: pip install -r backend/requirements.txt
.venv/
venv/
env/

# ── pytest cache (generated on every test run) ────────────────────────────────
# Created by pytest automatically. Contains no source — only performance cache.
.pytest_cache/

# ── Node.js dependencies ──────────────────────────────────────────────────────
# ~200 MB of packages reinstallable with: npm install
# package-lock.json is kept (committed) — it locks exact versions for reproducibility.
frontend/node_modules/

# ── Frontend production build ─────────────────────────────────────────────────
# Generated by: npm run build  ->  frontend/dist/
# Rebuilt before each deployment. Should never be committed.
frontend/dist/

# ── Pre-compiled JS stubs (Phase 1 placeholder files) ─────────────────────────
# .js counterparts exist alongside .tsx sources (App.js, main.js).
# These are stale Phase 1 artifacts — the .tsx files are the real source.
# They caused test runner conflicts and are not needed.
frontend/src/*.js
frontend/src/**/*.js

# ── SQLite runtime database ───────────────────────────────────────────────────
# Created and written to at runtime. Contains all session history, scores,
# streaks, topic data, and student profile. Changes constantly — not suitable
# for version control. Recreated via: python -m backend.scripts.import_questions
data/*.db

# ── Student uploads and generated PDFs ───────────────────────────────────────
# Written at runtime when students upload answer sheets or generate test papers.
# Includes personal answer PDFs — must not be committed.
data/uploads/

# ── Claude Code local state ───────────────────────────────────────────────────
# Machine-specific Claude Code session memory and project state.
# Not part of the application source.
.claude/

# ── Test coverage reports ─────────────────────────────────────────────────────
# Generated by pytest-cov or vitest --coverage on demand.
.coverage
htmlcov/
coverage.xml
coverage/

# ── OS and editor generated files ────────────────────────────────────────────
# Auto-generated by macOS Finder, Windows Explorer, and common IDEs.
# Irrelevant to the project on any platform.
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
