# Science Assessor — API keys
# Copy this file to .env and fill in whichever key you have.
# The app picks the first non-blank key in this order:
#   1. ANTHROPIC_API_KEY  →  claude-sonnet-4-6
#   2. GOOGLE_API_KEY     →  gemini-2.0-flash
#   3. OPENAI_API_KEY     →  gpt-4o
# If all are blank the app runs in stub/fallback mode (no AI features).

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
